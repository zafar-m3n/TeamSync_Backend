# Server
NODE_TEAMSYNC_NODE_ENV=development
NODE_TEAMSYNC_PORT=8080
NODE_TEAMSYNC_CLIENT_URL=http://localhost:5173

# Database
NODE_TEAMSYNC_DB_HOST=127.0.0.1
NODE_TEAMSYNC_DB_PORT=3306
NODE_TEAMSYNC_DB_NAME=teamsync
NODE_TEAMSYNC_DB_USER=root
NODE_TEAMSYNC_DB_PASSWORD=

# JWT
NODE_TEAMSYNC_JWT_SECRET=replace_with_a_long_random_secret
NODE_TEAMSYNC_JWT_EXPIRES_IN=12h

# Password hashing (used starting in Phase 3 — Roles & Departments, account creation)
NODE_TEAMSYNC_BCRYPT_SALT_ROUNDS=10

# Zoho SMTP
NODE_TEAMSYNC_SMTP_HOST=smtp.zoho.com
NODE_TEAMSYNC_SMTP_PORT=465
NODE_TEAMSYNC_SMTP_SECURE=true
NODE_TEAMSYNC_SMTP_USER=
NODE_TEAMSYNC_SMTP_PASSWORD=
NODE_TEAMSYNC_SMTP_FROM_EMAIL=
NODE_TEAMSYNC_SMTP_FROM_NAME=TeamSync

# Uploads
NODE_TEAMSYNC_UPLOAD_MAX_SIZE_MB=5

# Timezone (used starting in Phase 6 — Attendance & Shifts, and Phase 7 — Leave
# Management, for shift-time comparisons and year-end leave resets)
NODE_TEAMSYNC_APP_TIMEZONE=UTC

# Cron schedule for the daily attendance job (used starting in Phase 6 —
# Attendance & Shifts): auto clock-out at shift end, auto-mark Absent.
# Default below runs once daily at midnight.
NODE_TEAMSYNC_ATTENDANCE_CRON_SCHEDULE=0 0 * * *

# Pagination defaults (used by utils/pagination.js from Phase 1 onward)
NODE_TEAMSYNC_PAGINATION_DEFAULT_LIMIT=20
NODE_TEAMSYNC_PAGINATION_MAX_LIMIT=100
